{
  "name": "@ingenium/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "playwright test",
    "test:bundle": "node --test test/bundle.check.mjs",
    "preview:participant": "node --import tsx test/preview-server.ts",
    "preview:round2": "node --import tsx test/preview-server.ts --round2"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "lucide-react": "1.61.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io-client": "4.8.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "vite": "8.3.5"
  }
}
