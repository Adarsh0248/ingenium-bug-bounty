# Unusable placeholders. Install a private service-owned copy outside Git.
[global]
repo1-type=gcs
repo1-gcs-bucket=REPLACE_WITH_PRIVATE_BUCKET
repo1-path=/ingenium/REPLACE_WITH_DEPLOYMENT_ID
repo1-gcs-key-type=service
repo1-gcs-key=/etc/ingenium-backup/gcs-service-account.json
repo1-storage-verify-tls=y
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_WITH_SEPARATE_RANDOM_BACKUP_KEY
repo1-retention-full-type=time
repo1-retention-full=14
repo1-retention-history=0
expire-auto=n
archive-async=n
archive-check=y
archive-copy=y
backup-standby=n
start-fast=y
process-max=2
log-level-console=off
log-level-stderr=error
log-level-file=off
lock-path=/run/pgbackrest

[ingenium]
pg1-path=/var/lib/postgresql/data
pg1-socket-path=/var/run/postgresql
pg1-user=ingenium_schema_owner
